# ===== small-rag 单容器配置 =====
# 复制为 .env 后按需修改；.env 已被 .gitignore 忽略。

# 唯一对外端口：MCP/HTTP
APP_PORT=18080
APP_IMAGE_TAG=1.0.0

# Qdrant（容器内只监听 127.0.0.1，不对外暴露）
QDRANT_COLLECTION=small_rag_text
# 留空表示不启用鉴权
QDRANT_API_KEY=

# Ollama 模型常驻内存，避免每次请求重新加载
OLLAMA_KEEP_ALIVE=-1

# 向量模型：默认从 ModelScope 拉取（Qwen3-Embedding-0.6B，1024 维）
EMBEDDING_BASE_URL=http://127.0.0.1:11434/v1
EMBEDDING_API_KEY=ollama
EMBEDDING_MODEL=modelscope.cn/Qwen/Qwen3-Embedding-0.6B-GGUF
EMBEDDING_DIMENSION=1024

# true：启动时等待 Ollama 并确保 EMBEDDING_MODEL 已拉取
# 使用外部 OpenAI 兼容 Embedding 服务时设为 false
SMALL_RAG_ENSURE_OLLAMA_MODEL=true

# 构建用基础镜像（国内可换成镜像站）
MAVEN_IMAGE=docker.io/library/maven:3.9-eclipse-temurin-25
OLLAMA_IMAGE=docker.io/ollama/ollama:latest
QDRANT_IMAGE=docker.io/qdrant/qdrant:latest
JRE_IMAGE=docker.io/library/eclipse-temurin:25-jre

# 国内镜像示例：
# MAVEN_IMAGE=docker.1ms.run/library/maven:3.9-eclipse-temurin-25
# OLLAMA_IMAGE=docker.1ms.run/ollama/ollama:latest
# QDRANT_IMAGE=docker.1ms.run/qdrant/qdrant:latest
# JRE_IMAGE=docker.1ms.run/library/eclipse-temurin:25-jre
