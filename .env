# ===== small-rag 单容器配置 =====
# 构建与运行配置（.env 随仓库提交，只放模板值；真实密钥用部署环境注入）。

# 唯一对外端口：MCP/HTTP
APP_PORT=18080
APP_IMAGE_TAG=0.0.3

# Qdrant（容器内只监听 127.0.0.1，不对外暴露）
QDRANT_COLLECTION=small_rag_text
# 留空表示不启用鉴权
QDRANT_API_KEY=
# 常规 RPC（写入/删除/检索）deadline（毫秒）
QDRANT_REQUEST_TIMEOUT_MS=30000

# 向量模型：容器内 llama.cpp 加载 Qwen3-Embedding-0.6B（1024 维），首次启动从 ModelScope 下载
EMBEDDING_BASE_URL=http://127.0.0.1:11434/v1
EMBEDDING_API_KEY=local
# API 侧模型名（llama.cpp 的 OpenAI 兼容端点不校验）
EMBEDDING_MODEL=qwen3-embedding-0.6b
EMBEDDING_DIMENSION=1024
# Embedding HTTP 超时（毫秒）：connect / read（同时作为 write 与单次请求总超时）
EMBEDDING_CONNECT_TIMEOUT_MS=10000
EMBEDDING_READ_TIMEOUT_MS=120000
# GGUF 模型下载地址与落盘路径（路径须位于持久化卷 /data 内）
EMBEDDING_MODEL_URL=https://modelscope.cn/models/Qwen/Qwen3-Embedding-0.6B-GGUF/resolve/master/Qwen3-Embedding-0.6B-Q8_0.gguf
EMBEDDING_MODEL_PATH=/data/models/qwen3-embedding-0.6b-q8_0.gguf

# true：启动时等待容器内 Embedding 服务就绪
# 使用外部 OpenAI 兼容 Embedding 服务时设为 false
SMALL_RAG_ENSURE_EMBEDDING_MODEL=true

# 切分策略：fixed | recursive | semantic | parent-child（默认 parent-child）
# 切换策略后，已归档文档会在重启后自动重切；未归档历史数据需重新入库
CHUNK_STRATEGY=parent-child
CHUNK_SIZE=800
CHUNK_OVERLAP=100
# 启动时检测切分参数变化并重建已归档文档的向量
CHUNK_AUTO_RECHUNK=true
# 异步重建看门狗（秒）：停滞只告警，超过 hard 才中断线程；0 关闭
REINDEX_STALL_TIMEOUT_SECONDS=1800
REINDEX_HARD_TIMEOUT_SECONDS=3600
REINDEX_CHECK_INTERVAL_SECONDS=30
REINDEX_JOIN_TIMEOUT_SECONDS=10
# 硬超时撤销写权限后，等待在途写入结束的宽限期（秒）；到期强制释放任务锁
REINDEX_RECOVERY_GRACE_SECONDS=120
# 任务快照与任务锁存放在 Qdrant 的 <collection>_reindex_state 集合，跟随 Qdrant 持久化
# 启动时自动续接重启前未完成的重建任务；false 时停在 interrupted 并继续持锁
REINDEX_RESUME_ON_STARTUP=true
# 原始文档归档目录（自动重切依赖它，必须位于持久化卷中）
SMALL_RAG_ARCHIVE_DIR=/data/documents
# 多目录 Markdown 自动导入：逗号分隔目录（容器内路径），enabled=true 才生效
SMALL_RAG_SOURCES_ENABLED=false
SMALL_RAG_SOURCE_DIRS=
# compose.sources.yaml 使用的宿主机 Markdown 根目录（挂载到容器 /data/sources）
SMALL_RAG_SOURCE_HOST=./sources
SMALL_RAG_SOURCE_EXTENSIONS=.md,.markdown
SMALL_RAG_SOURCE_EXCLUDE=**/node_modules/**,**/target/**,**/build/**
SMALL_RAG_SOURCES_SKIP_HIDDEN=true
SMALL_RAG_SOURCES_FOLLOW_SYMLINKS=false
SMALL_RAG_SOURCES_SCAN_ON_STARTUP=true
SMALL_RAG_SOURCES_SCAN_INTERVAL_SECONDS=300
SMALL_RAG_SOURCES_WATCH_ENABLED=true
SMALL_RAG_SOURCES_WATCH_DEBOUNCE_SECONDS=5
SMALL_RAG_SOURCES_MAX_FILE_BYTES=2097152
SMALL_RAG_SOURCES_MAX_FILES_PER_SCAN=0
SMALL_RAG_SOURCES_DELETE_MISSING=false
SMALL_RAG_SOURCES_DELETE_ORPHAN_ROOTS=false
SMALL_RAG_SOURCES_STATE_FILE=
# 检索结果 MMR 多样性权重 λ（0 < λ < 1 启用，1 = 纯相关排序）
MMR_LAMBDA=0.7
# 仅 semantic 策略生效：文本块与当前块质心相似度低于该值时断开
SEMANTIC_SIMILARITY_THRESHOLD=0.75
# 仅 semantic 策略生效：断点分位数（0~1），> 0 时用相邻文本块相似度分位数替代绝对阈值
SEMANTIC_BREAKPOINT_PERCENTILE=0
# 仅 parent-child 策略生效：子块写入向量库，检索命中后返回父块
PARENT_CHUNK_SIZE=2000
# 父块重叠默认 0：子块不跨父块边界，父块重叠只会造成内容重复命中
PARENT_CHUNK_OVERLAP=0
CHILD_CHUNK_SIZE=400

# llama.cpp 源码版本（GitHub tag），镜像内从源码编译 llama-server
LLAMA_CPP_TAG=v0.9.0

# 构建用基础镜像：默认走国内镜像站（docker.io 直连不可用时不要改回官方地址）
MAVEN_IMAGE=docker.1ms.run/library/maven:3.9-eclipse-temurin-25
QDRANT_IMAGE=docker.1ms.run/qdrant/qdrant:latest
JRE_IMAGE=docker.1ms.run/library/eclipse-temurin:25-jre
# 分布式 overlay 用到的服务镜像
REDIS_IMAGE=docker.1ms.run/library/redis:7-alpine
REDIS_DATABASE=0
CONSUL_IMAGE=docker.1ms.run/hashicorp/consul:1.20
